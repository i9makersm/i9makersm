{
  "name": "i9smart-erp-educacional",
  "version": "5.0.8",
  "description": "Sistema ERP Educacional completo — i9 Smart",
  "private": true,
  "scripts": {
    "dev:api":     "ts-node api-backend.ts",
    "dev:api2":    "ts-node api-routes-v2.ts",
    "dev":         "concurrently \"npm run dev:api\" \"npm run dev:api2\"",
    "build":       "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push":     "prisma db push",
    "db:seed":     "echo 'Execute seed-test-data.sql no Supabase SQL Editor'",
    "start":       "node dist/api-backend.js"
  },
  "dependencies": {
    "@prisma/client":          "^5.14.0",
    "@supabase/supabase-js":   "^2.43.0",
    "@fastify/cors":           "^9.0.0",
    "@fastify/multipart":      "^8.0.0",
    "fastify":                 "^4.27.0",
    "zod":                     "^3.23.0"
  },
  "devDependencies": {
    "concurrently":  "^8.2.0",
    "prisma":        "^5.14.0",
    "ts-node":       "^10.9.0",
    "typescript":    "^5.4.0",
    "@types/node":   "^20.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
