{
  "name": "i9smart-erp-educacional",
  "version": "5.0.8",
  "description": "Sistema ERP Educacional completo — i9 Smart",
  "private": true,
  "prisma": {
    "schema": "prisma-schema.prisma"
  },
  "scripts": {
    "dev:api": "ts-node api-backend.ts",
    "dev:api2": "node scripts/dev-api2.js",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:api2\"",
    "build": "tsc -p tsconfig.json",
    "build:netlify": "npm run build && node scripts/build-netlify.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node scripts/provision-test-env.js",
    "db:bootstrap": "npm run db:push && npm run db:seed",
    "setup:access": "node scripts/setup-access-flow.js",
    "setup": "node scripts/setup.js",
    "start": "node dist/api-backend.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@prisma/client": "^5.14.0",
    "@supabase/supabase-js": "^2.43.0",
    "fastify": "^5.8.5",
    "ws": "^8.18.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.0",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
